# Local development only. Initialize-LocalEnvironment.ps1 creates real values in .env.
DJANGO_SECRET_KEY=replace-with-a-generated-local-secret
POSTGRES_PASSWORD=replace-with-a-generated-local-password
POSTGRES_DB=docinsight
POSTGRES_USER=docinsight
DB_HOST_PORT=5432
BACKEND_PORT=8000
FRONTEND_PORT=5173

# Optional sender store; leave blank until real connection setup is approved.
# Separate Fernet key, never DJANGO_SECRET_KEY. Never commit an actual key.
GMAIL_CREDENTIAL_ENCRYPTION_KEY=
